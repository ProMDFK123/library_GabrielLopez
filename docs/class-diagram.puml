
@startuml
' Library monolith — Stage 3: gRPC Member Service
' Layered: controller -> service -> dao -> model.
' gRPC provides an additional interface to MemberService.

skin rose

skinparam package<<controller>> {
  BackgroundColor #FCE4EC
  BorderColor #D81B60
}
skinparam package<<service>> {
  BackgroundColor #E3F2FD
  BorderColor #1976D2
}
skinparam package<<dao>> {
  BackgroundColor #E8F5E9
  BorderColor #388E3C
}
skinparam package<<model>> {
  BackgroundColor #FFF8E1
  BorderColor #F9A825
}
skinparam package<<db>> {
  BackgroundColor #F3E5F5
  BorderColor #7B1FA2
}
skinparam package<<grpc>> {
  BackgroundColor #E0F2F1
  BorderColor #00897B
}

hide stereotype

' ==================================================
' CONTROLLERS
' ==================================================

package "controller" <<controller>> {
  class BookController {
    - BookService service
    + BookController(BookService)
    + register(JavalinConfig) : void
  }

  class LoanController {
    - LoanService loanService
    + LoanController(LoanService)
    + register(JavalinConfig) : void
  }

  class MemberController {
    - MemberService service
    + MemberController(MemberService)
    + register(JavalinConfig) : void
  }

  class ReservationController {
    - ReservationService service
    + ReservationController(ReservationService)
    + register(JavalinConfig) : void
  }
}

' ==================================================
' SERVICES
' ==================================================

package "service" <<service>> {
  class BookService {
    - BookDao dao
    + listAll() : List<Book>
    + findById(int) : Book
    + create(Book) : Book
    + borrow(int) : void
    + returnCopy(int) : void
  }

  class LoanService {
    - LoanDao loanDao
    - MemberDao memberDao
    - BookService bookService
    - Clock clock
    + LoanService(LoanDao, MemberDao, BookService, Clock)
    + findAll() : List<Loan>
    + checkout(int, int) : Loan
    + returnLoan(int) : Loan
    + overdueLoans() : List<Loan>
    - withAccruedFees(List<Loan>) : List<Loan>
    - accruedFee(Loan, LocalDate) : double
  }

  class MemberService {
    - MemberDao memberDao
    + MemberService(MemberDao)
    + register(Member) : Member
    + findById(int) : Member
    + findAll() : List<Member>
  }

  class ReservationService {
    - ReservationDao reservationDao
    - MemberDao memberDao
    - LoanDao loanDao
    - BookService bookService
    - Clock clock
    + ReservationService(ReservationDao, MemberDao, LoanDao, BookService, Clock)
    + reserve(int, int) : Reservation
    + findAll() : List<Reservation>
    + fulfill(int) : Loan
  }

  class LoanPolicy {
    {static} + int DUE_DAYS = 21
    {static} + double FEE_PER_DAY = 1.0
    {static} + dueDate(LocalDate) : LocalDate
  }

  class NotFoundException extends RuntimeException
}

' ==================================================
' GRPC
' ==================================================

package "grpc" <<grpc>> {

  class GrpcServer {
    - int port
    - Server server
    + GrpcServer(int)
    + start(MemberGrpcService) : void
    + stop() : void
    + awaitTermination() : void
  }

  class MemberGrpcService {
    - MemberService memberService
    + MemberGrpcService(MemberService)
    + getMember(GetMemberRequest, StreamObserver) : void
    + listMembers(ListMembersRequest, StreamObserver) : void
    + createMember(CreateMemberRequest, StreamObserver) : void
    - toResponse(Member) : MemberResponse
  }

  class MemberServiceImplBase <<generated>> {
    + getMember(GetMemberRequest, StreamObserver) : void
    + listMembers(ListMembersRequest, StreamObserver) : void
    + createMember(CreateMemberRequest, StreamObserver) : void
  }

  class GetMemberRequest <<protobuf>> {
    - int id
  }

  class ListMembersRequest <<protobuf>>

  class CreateMemberRequest <<protobuf>> {
    - String name
    - String email
  }

  class MemberResponse <<protobuf>> {
    - int id
    - String name
    - String email
  }

  class ListMembersResponse <<protobuf>> {
    - List<MemberResponse> members
  }
}

' ==================================================
' DAO
' ==================================================

package "dao" <<dao>> {
  abstract class BaseDao<T> {
    # Dao<T, Integer> dao
    + findAll() : List<T>
    + findById(int) : T
    + create(T) : void
    + update(T) : void
    + delete(T) : void
    + transaction(Callable<R>) : R
  }

  class BookDao
  class MemberDao
  class LoanDao
  class ReservationDao
}

' ==================================================
' MODEL
' ==================================================

package "model" <<model>> {
  class Book {
    - int id
    - String title
    - String author
    - String isbn
    - int totalCopies
    - int availableCopies
  }

  class Member {
    - int id
    - String name
    - String email
  }

  class Loan {
    - int id
    - Member member
    - Book book
    - LocalDate loanDate
    - LocalDate dueDate
    - LocalDate returnDate
    - boolean returned
    - double overdueFee
  }

  class Reservation {
    - int id
    - Member member
    - Book book
    - LocalDate reservedAt
    - boolean fulfilled
  }
}

' ==================================================
' DATABASE
' ==================================================

package "db" <<db>> {
  class LocalDatePersister {
    - {static} LocalDatePersister INSTANCE
    + {static} getSingleton() : LocalDatePersister
  }

  class Database {
    - ConnectionSource connectionSource
    + connectionSource() : ConnectionSource
    + seedIfEmpty() : void
  }
}

' ==================================================
' CONTROLLER -> SERVICE
' ==================================================

BookController "1" --> "1" BookService
LoanController "1" --> "1" LoanService
MemberController "1" --> "1" MemberService
ReservationController "1" --> "1" ReservationService

' ==================================================
' SERVICE -> DAO / SERVICE
' ==================================================

BookService "1" --> "1" BookDao

LoanService "1" --> "1" LoanDao
LoanService "1" --> "1" MemberDao
LoanService "1" --> "1" BookService

MemberService "1" --> "1" MemberDao

ReservationService "1" --> "1" ReservationDao
ReservationService "1" --> "1" MemberDao
ReservationService "1" --> "1" LoanDao
ReservationService "1" --> "1" BookService

' ==================================================
' GRPC -> SERVICE / GRPC SERVER
' ==================================================

GrpcServer "1" --> "1" MemberGrpcService
MemberGrpcService "1" --> "1" MemberService
MemberGrpcService --|> MemberServiceImplBase

' gRPC request and response types
MemberGrpcService ..> GetMemberRequest
MemberGrpcService ..> ListMembersRequest
MemberGrpcService ..> CreateMemberRequest
MemberGrpcService ..> MemberResponse
MemberGrpcService ..> ListMembersResponse

ListMembersResponse "1" o-- "0..*" MemberResponse

' ==================================================
' DAO INHERITANCE
' ==================================================

BookDao --|> BaseDao
MemberDao --|> BaseDao
LoanDao --|> BaseDao
ReservationDao --|> BaseDao

' ==================================================
' DAO -> MODEL / DATABASE
' ==================================================

BookDao "1" --> "0..*" Book
MemberDao "1" --> "0..*" Member
LoanDao "1" --> "0..*" Loan
ReservationDao "1" --> "0..*" Reservation

BookDao "1" ..> "1" Database
MemberDao "1" ..> "1" Database
LoanDao "1" ..> "1" Database
ReservationDao "1" ..> "1" Database

' ==================================================
' MODEL RELATIONSHIPS
' ==================================================

Loan "0..*" --> "1" Member
Loan "0..*" --> "1" Book

Reservation "0..*" --> "1" Member
Reservation "0..*" --> "1" Book

Loan ..> LocalDatePersister
Reservation ..> LocalDatePersister

' gRPC response represents the Member model
MemberResponse ..> Member : maps to

@enduml
